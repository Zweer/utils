{
  "name": "@zweer/utils",
  "version": "1.4.0",
  "private": true,
  "description": "A monorepo containing a collection of useful Node.js CLI utilities",
  "keywords": [
    "utils",
    "cli",
    "scripts",
    "tools"
  ],
  "homepage": "https://github.com/Zweer/utils#readme",
  "bugs": {
    "url": "https://github.com/Zweer/utils/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zweer/utils.git"
  },
  "license": "MIT",
  "author": {
    "name": "Zweer",
    "email": "n.olivieriachille@gmail.com"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "npm install",
    "clean": "rimraf --glob packages/**/dist",
    "docs:build": "astro build --root docs",
    "docs:dev": "astro dev --root docs",
    "docs:preview": "astro preview --root docs",
    "prelint": "npm run build",
    "lint": "concurrently npm:lint:* --prefixColors auto",
    "postlint": "npm run clean",
    "lint:engines": "ls-engines",
    "lint:format": "biome check --write",
    "lint:lockfile": "lockfile-lint",
    "lint:package": "npmPkgJsonLint .",
    "lint:sort_package": "sort-package-json \"package.json\" \"packages/*/package.json\"",
    "lint:typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "prescripts:dummy": "npm run build",
    "scripts:dummy": "publish-dummy-package",
    "postscripts:dummy": "npm run clean",
    "pretest": "npm run build",
    "test": "vitest run",
    "posttest": "npm run clean",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "posttest:coverage": "coverage-badge-readme && npm run clean"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.8"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@astrojs/starlight": "^0.43.1",
    "@biomejs/biome": "^2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@zweer/coverage-badge-readme": "^1.4.0",
    "astro": "^7.4.12",
    "bonvoy": "^0.13.2",
    "concurrently": "^10.0.7",
    "lefthook": "^2.2.2",
    "lockfile-lint": "^5.1.0",
    "ls-engines": "^0.10.1",
    "memfs": "^4.80.1",
    "npm-package-json-lint": "^11.0.1",
    "npm-package-json-lint-config-default": "^10.0.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.4",
    "sort-package-json": "^4.1.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">= 22.18"
  },
  "lockfile-lint": {
    "path": "package-lock.json",
    "type": "npm",
    "validate-https": true,
    "allowed-hosts": [
      "npm"
    ]
  }
}
